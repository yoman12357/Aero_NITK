# ==============================================================================
# Aero NITK Website - Environment Variables
# ==============================================================================
# Copy this file to '.env' (or '.env.local') in the project root:
#   cp .env.example .env
# Replace the placeholder values with your actual configuration keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & FEATURE FLAGS
# ------------------------------------------------------------------------------
# Set to 'true' to display the temporary maintenance / stress-test countdown page.
# Set to 'false' for normal site operation.
VITE_MAINTENANCE_MODE=false

# Comma-separated list of authorized email addresses for admin / dashboard login
# Example: admin@aeronitk.in,lead@aeronitk.in
VITE_ALLOWED_EMAIL=admin@aeronitk.in

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
# URL of the backend server (used for team data, gallery management, and dashboard)
# Local development: http://localhost:3001
# Production: https://aeronitk-backend.onrender.com
# VITE_BACKEND_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (Web Client SDK)
# ------------------------------------------------------------------------------
# Obtain these values from your Firebase Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=test-aero-a8a02.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://test-aero-a8a02-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=test-aero-a8a02
VITE_FIREBASE_STORAGE_BUCKET=test-aero-a8a02.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. EMAILJS CONFIGURATION (Contact Form)
# ------------------------------------------------------------------------------
# Obtain these credentials from your EmailJS dashboard (https://dashboard.emailjs.com)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ------------------------------------------------------------------------------
# 5. SANITY CMS CONFIGURATION (Frontend Client)
# ------------------------------------------------------------------------------
# Sanity project credentials for fetching events, gallery, and dynamic content
# Obtain from https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
